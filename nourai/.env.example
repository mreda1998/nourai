# ─── Backend ─────────────────────────────────────────────────────────────────
# Your deployed API URL (Railway, Fly, Render, etc.)
EXPO_PUBLIC_API_URL=https://api.elory.com/api/v1

# ─── Supabase ─────────────────────────────────────────────────────────────────
# Supabase → Project Settings → API
EXPO_PUBLIC_SUPABASE_URL=https://[project-ref].supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# RevenueCat public SDK keys. Never put secret API keys in EXPO_PUBLIC variables.
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
EXPO_PUBLIC_REVENUECAT_ENTITLEMENT_ID=Elory Pro
# Optional test-store key, accepted only in development builds.
EXPO_PUBLIC_REVENUECAT_TEST_KEY=
