{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": true
      }
    },
    "preview": {
      "distribution": "internal",
      "ios": {
        "simulator": false
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.elory.app/api/v1"
      }
    },
    "production": {
      "environment": "production",
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.elory.app/api/v1"
      }
    },
    "testflight": {
      "extends": "production",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://nourai-production.up.railway.app/api/v1",
        "EXPO_PUBLIC_TESTER_MODE": "1"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {}
    },
    "testflight": {
      "extends": "production"
    }
  }
}
