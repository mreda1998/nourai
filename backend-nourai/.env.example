# ─── Local development ────────────────────────────────────────────────────────
# Copy this to .env and fill in your values.
# For local dev (Docker Compose postgres), the defaults below work as-is.

# Database
# Local:    postgresql+asyncpg://postgres:postgres@localhost:5432/postgres
# Supabase: postgresql+asyncpg://postgres:[PASSWORD]@db.[PROJECT].supabase.co:5432/postgres
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/postgres

# App
ENVIRONMENT=development
DEBUG=true

# ─── Supabase ─────────────────────────────────────────────────────────────────
# Project Settings → API
SUPABASE_URL=https://[project].supabase.co
SUPABASE_JWT_SECRET=your-jwt-secret
# Project Settings → API → service_role (secret) — used by server-side scripts only
SUPABASE_SERVICE_ROLE_KEY=

# Storage → New Bucket → name: "product-images", toggle Public = ON
SUPABASE_STORAGE_BUCKET=product-images
# Storage → New Bucket → name: "tester-submissions", Public = OFF (private).
# Holds label photos testers send for products we don't have yet.
SUPABASE_SUBMISSIONS_BUCKET=tester-submissions

# ─── Research agent ───────────────────────────────────────────────────────────
# https://console.anthropic.com
ANTHROPIC_API_KEY=

# Optional — raises PubMed from 3 req/s to 10 req/s
# Register free at https://www.ncbi.nlm.nih.gov/account/
NCBI_API_KEY=

# OpenAI — used for mechanism illustration generation (gpt-image-1.5)
# https://platform.openai.com/api-keys
OPENAI_API_KEY=

# ─── External ─────────────────────────────────────────────────────────────────
OPENFOODFACTS_API_BASE=https://world.openfoodfacts.org/api/v3.6
OPENFOODFACTS_CONTACT_EMAIL=hello@elory.app
OPENFOODFACTS_USER_AGENT=Elory/1.0 (hello@elory.app)

# Durable worker and authentic-image processing
INGESTION_WORKER_ID=elory-ingestion-worker
INGESTION_POLL_SECONDS=1.0
INGESTION_JOB_LEASE_SECONDS=300
INGESTION_JOB_MAX_ATTEMPTS=5
IMAGE_MAX_DOWNLOAD_BYTES=15000000
IMAGE_PROCESSING_ENABLED=true

# ─── USDA FoodData Central ────────────────────────────────────────────────────
# Free API key: https://fdc.nal.usda.gov/api-guide.html
# Used for whole/unpackaged foods (salmon, broccoli, eggs, etc.)
USDA_API_KEY=

# ─── RapidAPI ─────────────────────────────────────────────────────────────────
# https://rapidapi.com/auth/sign-up → subscribe to "Sephora" API (free tier: 500 req/mo)
# Used for luxury fragrance product data (Dior, Chanel, LV, Creed, Tom Ford...)
RAPIDAPI_KEY=

# ─── RevenueCat ───────────────────────────────────────────────────────────────
# RevenueCat: configure the webhook Authorization header to exactly match this value.
# Use a long random value, e.g. Bearer <random-token>. Verification never bypasses it.
REVENUECAT_WEBHOOK_SECRET=
# Server-only RevenueCat v1 API key; NEVER expose in the app bundle.
REVENUECAT_SECRET_API_KEY=
REVENUECAT_ENTITLEMENT_ID=Elory Pro
# Enable only on an isolated test/beta backend for sandbox subscriptions.
REVENUECAT_ALLOW_SANDBOX=false
# Friends beta only: every signed-in user gets premium (tester builds skip RevenueCat).
# Turn off before selling subscriptions.
PREMIUM_OPEN_BETA=false
